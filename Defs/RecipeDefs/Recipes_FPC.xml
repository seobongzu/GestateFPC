  <RecipeDef ParentName="BaseMechanoidResurrectionRecipe">
    <defName>ResurrectFPCMech</defName>
    <label>resurrect FPC</label>
    <description>Resurrect a friendly mechanoid of the FPC class. So long as the mechanoid's body is not completely destroyed, it can be resurrected.</description>
    <ingredients>
      <li>
        <filter>
          <categories>
            <li>Corpses</li>
          </categories>
        </filter>
        <count>1</count>
      </li>
      <li>
        <filter>
          <thingDefs>
            <li>Foerum</li>
          </thingDefs>
        </filter>
        <count>50</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Corpse_Mech_FPCSeeker</li>
        <li>Corpse_Mech_FPCPeacekeeper</li>
        <li>Corpse_Mech_FPCPeacemaker</li>

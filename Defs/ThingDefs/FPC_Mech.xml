<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Seeker -->  
	<ThingDef ParentName="BaseMechanoid">
		<defName>Mech_FPCSeeker</defName>
		<label>seeker</label>
		<description>A small, agile unarmed scout biodrone that deployed by the Federation. It's bioreactor is unstable and explodes upon destruction.</description>
		<statBases>
			<MoveSpeed>6</MoveSpeed>
			<ArmorRating_Blunt>0</ArmorRating_Blunt>
			<ArmorRating_Sharp>0.1</ArmorRating_Sharp>
			<ArmorRating_Heat>0</ArmorRating_Heat>
			<PsychicSensitivity>1.25</PsychicSensitivity>
			<Mass>25</Mass>
			<BandwidthCost MayRequire="Ludeon.RimWorld.Biotech">1</BandwidthCost>			
		</statBases>
		<tools>
			<li>
				<label>head</label>
				<capacities>
					<li>Blunt</li>
				</capacities>
				<power>5</power>
				<cooldownTime>1.9</cooldownTime>
				<linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
				<ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
			</li>
		</tools>
		<race>
			<intelligence>ToolUser</intelligence>
			<thinkTreeMain>Mechanoid</thinkTreeMain>	  
			<body>Biodrone</body>
			<mechWeightClass>Light</mechWeightClass>
			<deathAction>
				<workerClass>DeathActionWorker_SmallExplosion</workerClass>
			</deathAction>			
			<baseBodySize>0.5</baseBodySize>
			<baseHealthScale>0.5</baseHealthScale>
			<lifeStageAges>
				<li>
					<def>MechanoidFullyFormed</def>
					<minAge>0</minAge>
					<soundWounded>MechWound</soundWounded>
					<soundDeath>MechDeath</soundDeath>
					<soundCall>MechCall</soundCall>
					<soundAngry>MechAngry</soundAngry>
				</li>
			</lifeStageAges>		
			<soundMeleeHitPawn>MechHitPawn</soundMeleeHitPawn>
			<soundMeleeHitBuilding>MechHitPawn</soundMeleeHitBuilding>
			<soundMeleeMiss>MechMiss</soundMeleeMiss>			
		</race>
		<butcherProducts>
			<ComponentIndustrial>2</ComponentIndustrial>
			<Steel>10</Steel>
			<Foerum>10</Foerum>
		</butcherProducts>
	</ThingDef>
    
